<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.codex.xiaobu.launcherhook"
    android:versionCode="24"
    android:versionName="2.1.3">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="小布识屏增强" android:hasCode="true"
        android:theme="@style/ModuleSettingsTheme" android:allowBackup="false">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="扩展小布识屏和屏幕翻译的可用页面，支持识图与保存截图" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <activity android:name="dev.codex.xiaobu.settings.GestureSettingsActivity"
            android:label="小布识屏增强" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity android:name="dev.codex.xiaobu.WebSearchActivity" android:exported="true"
            android:label="识图" android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"
            android:excludeFromRecents="true" android:configChanges="orientation|screenSize|keyboardHidden" />
        <service android:name="dev.codex.xiaobu.settings.GestureObserverService"
            android:label="小布识屏增强 · 长按检测"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/gesture_observer" />
        </service>
        <provider android:name="dev.codex.xiaobu.settings.GestureSettingsProvider"
            android:authorities="dev.codex.xiaobu.launcherhook.settings"
            android:exported="true" android:grantUriPermissions="false" />
    </application>
</manifest>
